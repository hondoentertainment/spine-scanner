# Supabase (optional - app works fully offline without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site configuration (optional but recommended for launch)
# VITE_SITE_URL=https://your-public-domain.example
# VITE_BASE_PATH=/
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_ENABLE_SCANNER_DEBUG=false

# Amazon affiliate (optional - add your tag to buy links)
# VITE_AMAZON_AFFILIATE_TAG=yoursite-20

# Sentry error monitoring (optional - app works fully without this)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_APP_RELEASE=local-dev
# VITE_APP_ENV=production
