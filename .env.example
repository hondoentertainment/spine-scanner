# Copy to `.env` or `.env.local` for local development. Vite only exposes variables prefixed with `VITE_`.
#
# Build-time vs runtime: values are baked into the client bundle when you run `npm run build` or `vite build`.
# `vite preview` serves that existing bundle — changing env vars for the preview process alone does not alter the app
# unless you rebuild with the same vars. Set production vs preview values in the environment that runs the build
# (e.g. GitHub Actions, Vercel project envs), not only on the preview server.

# Supabase project URL; both URL and anon key must be set to enable cloud auth/sync, or leave both unset for local-only.
VITE_SUPABASE_URL=

# Supabase anonymous (public) key; paired with VITE_SUPABASE_URL.
VITE_SUPABASE_ANON_KEY=

# Do not set VITE_E2E_HOOKS. It is a Playwright-only build flag and must stay unset for deploys.
# Google sign-in uses the Supabase Auth Google provider. The Google client secret stays in Supabase, not here.

# Canonical site origin for meta tags, sitemap/robots (see vite.config.ts), and share links — no trailing slash, e.g. https://example.com.
VITE_SITE_URL=

# App base path with leading and trailing slashes (e.g. /spine-scanner/). Build default: / on Vercel, /spine-scanner/ otherwise if unset at build time.
VITE_BASE_PATH=

# Public support email for mailto links and policy copy (Profile & Settings).
VITE_SUPPORT_EMAIL=

# Scanner debug flag — checked by `npm run check:production`; must be false for production deploy checks.
VITE_ENABLE_SCANNER_DEBUG=false

# Optional Amazon Associates tag appended to generated Amazon search links (ISBN).
VITE_AMAZON_AFFILIATE_TAG=

# Sentry DSN for error monitoring; leave empty for no-op monitoring (see src/lib/errorMonitoring.ts).
VITE_SENTRY_DSN=

# Release identifier sent to Sentry (e.g. git SHA); app falls back to dev-local when unset.
VITE_APP_RELEASE=

# Environment label for Sentry and diagnostics; falls back to Vite’s mode (development/production) when unset.
VITE_APP_ENV=

# Optional shelf-photo vision assist. Leave unset for the free on-device detector (Tesseract + ZXing).
# When both are set, a shelf photo is also POSTed as JSON `{ "image": "<data-url>" }`.
# The endpoint should return `{ "books": [{ "title": "", "author": "", "isbn": "" }] }`.
# Failures fall back to on-device detection. The single-spine barcode/OCR scanner is unchanged.
# VITE_SHELF_VISION_API=true
# VITE_SHELF_VISION_ENDPOINT=https://your-vision-endpoint.example/shelf
#
# Optional shelf suggestions. Leave unset to use the free Google Books and Open Library path.
# When both are set, the app POSTs `{ "owned": [{ "title", "author", "subjects", "series" }], "limit": 12 }`
# and expects `{ "recommendations": [{ "title", "author", "isbn", "reason" }] }`.
# Each reason must start with "Because you own" and name books on the shelf.
# Failures fall back to the free path. The endpoint must be https, except http://localhost for local development.
# VITE_RECOMMENDATIONS_LLM=true
# VITE_RECOMMENDATIONS_LLM_ENDPOINT=https://your-suggestions-endpoint.example/recommendations
#
# UI shell: set `mvp` for scan-first minimal UI, or `full` / omit for the full app (Home tab, marketing hero on Scan, rich profile, library segment bar, highlight grid, saved views).
# Any value other than exactly `mvp` behaves like the full app. Literal `empty` is not implemented as its own mode (same UI as full); `npm run check:production` allows only unset, `mvp`, or `full`.
VITE_APP_MODE=
