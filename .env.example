# Supabase (optional — app works fully offline without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Amazon affiliate (optional — add your tag to buy links)
# VITE_AMAZON_AFFILIATE_TAG=yoursite-20

# Google Books API key (optional — increases daily quota from 1,000 to 1,000,000 req/day)
# Get yours at https://console.developers.google.com/
# VITE_GOOGLE_BOOKS_API_KEY=your-api-key
