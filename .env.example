# Supabase (optional — app works fully offline without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Amazon affiliate (optional — add your tag to buy links)
# VITE_AMAZON_AFFILIATE_TAG=yoursite-20

# Sentry error monitoring (REQUIRED in production — errors are invisible without it)
# Create a project at https://sentry.io and paste the DSN below.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Feature flags (optional — all default to true/enabled)
# Set to "false" to disable individual features at build time.
# VITE_FLAG_CLOUD_SYNC=true
# VITE_FLAG_REALTIME_SYNC=true
# VITE_FLAG_AMAZON_LINKS=true
# VITE_FLAG_OCR_SCANNING=true
# VITE_FLAG_SMART_SHELVES=true
# VITE_FLAG_BATCH_MODE=true
# VITE_FLAG_READING_PROGRESS=true
# VITE_FLAG_DEBUG_PANEL=false   # defaults to true only in dev
